  canonical: "https://www.raychan.top/note-principles.html",
  ogType: "article",
  ogImage: "https://www.raychan.top/assets/og/note-principles.png",
  ogUrl: "https://www.raychan.top/note-principles.html",
  twitterImage: "https://www.raychan.top/assets/og/note-principles.png",
