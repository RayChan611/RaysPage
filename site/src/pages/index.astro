---
import BaseLayout from '../layouts/BaseLayout.astro';
const meta = {
  title: "Ray Chan",
  description: "Ray Chan 的个人主页——量化策略、全栈工程与自我重建，记录自省与思考的 Soul-Searching、随手记的 notes、拍下的 photos。",
  canonical: "https://www.raychan.top/",
  ogType: "website",
  ogImage: "https://www.raychan.top/assets/og/default.png",
  // Use the real file path so Feishu/WeChat don't dedupe the link-preview card
  // by og:url="/" and serve a stale no-image cache. Home resolves to index.html.
  ogUrl: "https://www.raychan.top/index.html",
  twitterImage: "https://www.raychan.top/assets/og/default.png",
  extraCss: [],
  current: "home",
  preloadPhoto: true,
};
const bodyHtml = "<section class=\"hero\" id=\"hero\">\n    \n    <div class=\"hero-bg\">\n        <img src=\"assets/ray-photo.webp\" alt=\"\" class=\"hero-bg-img\" fetchpriority=\"high\" decoding=\"async\" width=\"2400\" height=\"1600\" />\n    </div>\n    \n    <div class=\"hero-overlay\" aria-hidden=\"true\"></div>\n\n    <div class=\"hero-content\">\n      \n      <div class=\"hero-text\">\n        <h1 class=\"hero-name\">\n          <span class=\"hero-name-line\">Ray</span>\n          <span class=\"hero-name-line hero-name-accent\">Chan</span>\n        </h1>\n        <p class=\"hero-tagline\" id=\"hero-tagline\"></p>\n        <div class=\"hero-cta\">\n          <div class=\"btn-magnetic\">\n            <a href=\"#about\" class=\"btn-primary\"><span>Explore</span><span class=\"btn-arrow\"> ↓</span></a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </section>\n\n  \n  <section class=\"section\" id=\"about\" aria-labelledby=\"about-title\">\n    <div class=\"container\">\n      <div class=\"section-header animate-on-scroll\">\n        <h2 class=\"section-title\" id=\"about-title\">About Me</h2>\n        <div class=\"section-line\"></div>\n      </div>\n\n      <div class=\"about-layout\">\n        \n        <div class=\"about-text\">\n            <p class=\"about-bio\">\n              Cherish · Remain&emsp;&emsp;温柔永存 · 岁岁相伴\n            </p>\n          <div class=\"about-tags\">\n            <span class=\"tag\">Project Manager</span>\n          </div>\n          <div class=\"about-focus\">\n            <span class=\"about-focus-label\">Currently focused on</span>\n            <p class=\"about-focus-text\">量化策略 · 全栈工程</p>\n          </div>\n        </div>\n\n        \n        <div class=\"about-experience\">\n          <div class=\"timeline\">\n            <div class=\"timeline-item\">\n              <span class=\"timeline-year\">2022 – 2025</span>\n              <span class=\"timeline-logo\">TCL</span>\n            </div>\n            <div class=\"timeline-item\">\n              <span class=\"timeline-year\">2025 – 2026</span>\n              <span class=\"timeline-logo\">CMB</span>\n            </div>\n            <div class=\"timeline-item timeline-item--current\">\n              <span class=\"timeline-year\">2026 – Now</span>\n              <span class=\"timeline-logo\">Manycore Tech</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section section-dark\" id=\"contact\" aria-labelledby=\"contact-title\">\n    <div class=\"container\">\n      <div class=\"section-header animate-on-scroll\">\n        <h2 class=\"section-title\" id=\"contact-title\">Get In Touch</h2>\n        <div class=\"section-line\"></div>\n      </div>\n\n      <div class=\"contact-grid\">\n        <div class=\"contact-card contact-card--flower\" data-href=\"mailto:chenrui0411@outlook.com\" data-copy=\"chenrui0411@outlook.com\">\n          <div class=\"contact-icon contact-icon--mail\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/></svg></div>\n          <div>\n            <h4>Email</h4>\n            <p>chenrui0411@outlook.com</p>\n          </div>\n          <span class=\"copy-hint\">点击复制</span>\n        </div>\n        <div class=\"contact-card contact-card--leaf\" data-href=\"tel:+8619874061160\" data-copy=\"19874061160\">\n          <div class=\"contact-icon contact-icon--phone\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z\"/></svg></div>\n          <div>\n            <h4>WeChat / Phone</h4>\n            <p>19874061160</p>\n          </div>\n          <span class=\"copy-hint\">点击复制</span>\n        </div>\n        <div class=\"contact-card contact-card--vine\" data-copy=\"广州\">\n          <div class=\"contact-icon contact-icon--pin\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z\"/><circle cx=\"12\" cy=\"9\" r=\"2.5\"/></svg></div>\n          <div>\n            <h4>Location</h4>\n            <p>广州</p>\n          </div>\n          <span class=\"copy-hint\">点击复制</span>\n        </div>\n      </div>\n\n      <div class=\"social-links\">\n        <a href=\"https://github.com/RayChan611\" target=\"_blank\" rel=\"noopener\" class=\"social-link\" aria-label=\"GitHub\">GitHub ↗</a>\n        <a href=\"https://www.linkedin.com/in/raychan611\" target=\"_blank\" rel=\"noopener\" class=\"social-link\" aria-label=\"LinkedIn\">LinkedIn ↗</a>\n        <a href=\"https://x.com/raychan22\" target=\"_blank\" rel=\"noopener\" class=\"social-link\" aria-label=\"X\">X ↗</a>\n        <a href=\"https://okjk.co/94n6Iu\" target=\"_blank\" rel=\"noopener\" class=\"social-link\" aria-label=\"Jike\">Jike ↗</a>\n      </div>\n    </div>\n  </section>";
const pageScripts = ["js/hero-typewriter.js","js/button-effects.js","js/card-tilt.js"];
---
<BaseLayout {...meta}>
  <Fragment set:html={bodyHtml} />
  {pageScripts.map((s) => <script is:inline defer src={'/' + s}></script>)}
</BaseLayout>
