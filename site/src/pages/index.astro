---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photoSeries } from '../data/photos';
import { compareContentNewestFirst, formatContentDate, getPublishedEssays, getPublishedNotes } from '../lib/content';

const [essays, notes] = await Promise.all([getPublishedEssays(), getPublishedNotes()]);
const recentEssay = essays.sort(compareContentNewestFirst)[0];
const recentNote = notes.sort(compareContentNewestFirst)[0];
const recentSeries = photoSeries.find((series) => series.id === 'lanpu' && series.photos.length > 0);
// 沿用阅读笔记中手写的可信摘录，仅取首段，避免在首页重复整张笔记卡。
const recentNoteExcerpt = recentNote?.data.excerpt.match(/<p\b[^>]*>([\s\S]*?)<\/p>/i)?.[1]
  ?? recentNote?.data.description ?? '';
const recentNoteHref = recentNote
  ? recentNote.data.hasDetail === false ? `/notes.html#note-${recentNote.id}` : `/note-${recentNote.id}.html`
  : undefined;

const meta = {
  title: 'Ray Chan',
  description: 'Ray Chan 的个人主页——量化策略、全栈工程与自我重建，记录自省与思考的 Soul-Searching、随手记的 notes、拍下的 photos。',
  canonical: 'https://www.raychan.top/',
  ogType: 'website',
  ogImage: 'https://www.raychan.top/assets/og/default.png',
  // Use the real file path so Feishu/WeChat do not dedupe the preview card
  // with a stale cache for the root URL. Home resolves to index.html.
  ogUrl: 'https://www.raychan.top/index.html',
  twitterImage: 'https://www.raychan.top/assets/og/default.png',
  extraCss: [],
  current: 'home',
  preloadPhoto: true,
  preloadPhotoMobile: '/assets/ray-photo-mobile.556d94fb.webp',
};

const pageScripts = ['js/hero-typewriter.js', 'js/button-effects.js', 'js/card-tilt.js', 'js/recent-entries.js'];
---
<BaseLayout {...meta} pageScripts={pageScripts}>
  <section class="hero" id="hero">
    <div class="hero-bg">
      <picture>
        <source media="(max-width: 768px)" srcset={meta.preloadPhotoMobile} width="990" height="1080" />
        <img
          src="/assets/ray-photo.98a946ad.webp"
          alt=""
          class="hero-bg-img"
          fetchpriority="high"
          decoding="async"
          width="2400"
          height="1621"
        />
      </picture>
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-name">
          <span class="hero-name-line">Ray</span>
          <span class="hero-name-line hero-name-accent">Chan</span>
        </h1>
        <p class="hero-tagline typewriter-pending" id="hero-tagline" aria-label="Ground-up rebuild. Capabilities. Mindset. Vision.">
          <span class="hero-tagline-line">Ground-up rebuild.</span><br />
          <span class="hero-tagline-line">Capabilities. Mindset. Vision.</span>
        </p>
        <div class="hero-cta">
          <div class="btn-magnetic">
            <a href="#about" class="btn-primary"><span>Explore</span><span class="btn-arrow"> ↓</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <h2 class="section-title" id="about-title">About Me</h2>
      </div>

      <div class="about-layout">
        <div class="about-text">
          <p class="about-bio"><span>Cherish · Remain</span><span>温柔永存 · 岁岁相伴</span></p>
          <div class="about-tags">
            <span class="tag">Project Manager</span>
          </div>
          <div class="about-focus">
            <span class="about-focus-label">Currently focused on</span>
            <p class="about-focus-text">量化策略 · 全栈工程</p>
          </div>
        </div>

        <div class="about-experience">
          <div class="timeline">
            <div class="timeline-item">
              <span class="timeline-year">2022 – 2025</span>
              <span class="timeline-logo">TCL</span>
            </div>
            <div class="timeline-item">
              <span class="timeline-year">2025 – 2026</span>
              <span class="timeline-logo">CMB</span>
            </div>
            <div class="timeline-item timeline-item--current">
              <span class="timeline-year">2026 – Now</span>
              <span class="timeline-logo">Manycore Tech</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {(recentSeries || recentEssay || recentNote) && (
    <section class="section" id="recent" aria-labelledby="recent-title">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <h2 class="section-title" id="recent-title">Recent Entries</h2>
        </div>
        <div class="recent-layout">
          {recentSeries && (
            <div class="recent-photo" role="group" aria-labelledby="recent-photo-title">
              <div class="recent-photo-view">
                <div class="recent-track" id="recent-track">
                  {recentSeries.photos.map((photo, photoIndex) => {
                    const image = {
                      src: photo.compact,
                      srcset: `${photo.small} ${photo.smallWidth}w, ${photo.compact} ${photo.compactWidth}w, ${photo.thumb} ${photo.thumbWidth}w`,
                      sizes: '(max-width: 768px) calc(100vw - 48px), (max-width: 1280px) calc(51.3vw - 44px), 614px',
                      width: photo.thumbWidth,
                      height: photo.thumbHeight,
                      alt: photo.alt,
                      decoding: 'async' as const,
                    };
                    return (
                      <a class="recent-photo-frame" href={`/photos.html#series-${recentSeries.id}`} inert={photoIndex > 0}>
                        {photoIndex === 0 ? <img {...image} loading="lazy" /> : <template><img {...image} /></template>}
                      </a>
                    );
                  })}
                </div>
                <button class="recent-photo-arrow" type="button" data-recent-prev aria-label="上一张照片" aria-controls="recent-track" hidden>
                  <span aria-hidden="true">←</span>
                </button>
                <button class="recent-photo-arrow" type="button" data-recent-next aria-label="下一张照片" aria-controls="recent-track" hidden>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
              <div class="recent-photo-caption">
                <div class="recent-meta"><span class="recent-kind">摄影</span><span>{recentSeries.photos.length} 张照片</span></div>
                <h3 class="recent-title" id="recent-photo-title">{recentSeries.name}</h3>
                <p class="recent-excerpt">{recentSeries.description}</p>
              </div>
            </div>
          )}
          {(recentEssay || recentNote) && (
            <div class="recent-text">
              {recentEssay && (
                <a class="recent-entry" href={`/essay-${recentEssay.id}.html`}>
                  <div class="recent-meta"><span class="recent-kind">文字</span><time datetime={recentEssay.data.date.toISOString()}>{formatContentDate(recentEssay.data.date)}</time></div>
                  <h3 class="recent-title">{recentEssay.data.title} <span class="recent-link-icon" aria-hidden="true">↗</span></h3>
                  <p class="recent-excerpt">{recentEssay.data.excerpt}</p>
                  <span class="recent-action">阅读全文 <span aria-hidden="true">→</span></span>
                </a>
              )}
              {recentNote && (
                <a class="recent-entry" href={recentNoteHref}>
                  <div class="recent-meta"><span class="recent-kind">阅读</span><time datetime={recentNote.data.date.toISOString()}>{formatContentDate(recentNote.data.date)}</time></div>
                  <h3 class="recent-title">{recentNote.data.book} <span class="recent-link-icon" aria-hidden="true">↗</span></h3>
                  <p class="recent-excerpt" set:html={recentNoteExcerpt}></p>
                  <span class="recent-action">{recentNote.data.hasDetail === false ? '查看摘录' : '阅读笔记'} <span aria-hidden="true">→</span></span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <h2 class="section-title" id="contact-title">Get In Touch</h2>
      </div>

      <div class="contact-grid">
        <div class="contact-card contact-card--flower" data-copy="chenrui0411@outlook.com">
          <div class="contact-icon contact-icon--mail" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </div>
          <div>
            <h3>Email</h3>
            <p>chenrui0411@<wbr />outlook.com</p>
          </div>
          <span class="copy-hint">点击复制</span>
        </div>
        <div class="contact-card contact-card--leaf" data-copy="19874061160">
          <div class="contact-icon contact-icon--phone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
          </div>
          <div>
            <h3>WeChat / Phone</h3>
            <p>19874061160</p>
          </div>
          <span class="copy-hint">点击复制</span>
        </div>
        <div class="contact-card contact-card--vine" data-copy="广州">
          <div class="contact-icon contact-icon--pin" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>
          </div>
          <div>
            <h3>Location</h3>
            <p>广州</p>
          </div>
          <span class="copy-hint">点击复制</span>
        </div>
      </div>

      <div class="social-links">
        <a href="https://github.com/RayChan611" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/raychan611" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">LinkedIn ↗</a>
        <a href="https://x.com/raychan22" target="_blank" rel="noopener" class="social-link" aria-label="X">X ↗</a>
        <a href="https://okjk.co/94n6Iu" target="_blank" rel="noopener" class="social-link" aria-label="Jike">Jike ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
