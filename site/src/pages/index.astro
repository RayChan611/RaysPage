---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'Ray Chan',
  description: 'Ray Chan 的个人主页——量化策略、全栈工程与自我重建，记录自省与思考的 Soul-Searching、随手记的 notes、拍下的 photos。',
  canonical: 'https://www.raychan.top/',
  ogType: 'website',
  ogImage: 'https://www.raychan.top/assets/og/default.png',
  // Use the real file path so Feishu/WeChat do not dedupe the preview card
  // with a stale cache for the root URL. Home resolves to index.html.
  ogUrl: 'https://www.raychan.top/index.html',
  twitterImage: 'https://www.raychan.top/assets/og/default.png',
  extraCss: [],
  current: 'home',
  preloadPhoto: true,
};

const pageScripts = ['js/hero-typewriter.js', 'js/button-effects.js', 'js/card-tilt.js'];
---
<BaseLayout {...meta} pageScripts={pageScripts}>
  <section class="hero" id="hero">
    <div class="hero-bg">
      <img
        src="/assets/ray-photo.webp"
        alt=""
        class="hero-bg-img"
        fetchpriority="high"
        decoding="async"
        width="2400"
        height="1621"
      />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-name">
          <span class="hero-name-line">Ray</span>
          <span class="hero-name-line hero-name-accent">Chan</span>
        </h1>
        <p class="hero-tagline" id="hero-tagline"></p>
        <div class="hero-cta">
          <div class="btn-magnetic">
            <a href="#about" class="btn-primary"><span>Explore</span><span class="btn-arrow"> ↓</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <h2 class="section-title" id="about-title">About Me</h2>
        <div class="section-line"></div>
      </div>

      <div class="about-layout">
        <div class="about-text">
          <p class="about-bio">Cherish · Remain&emsp;&emsp;温柔永存 · 岁岁相伴</p>
          <div class="about-tags">
            <span class="tag">Project Manager</span>
          </div>
          <div class="about-focus">
            <span class="about-focus-label">Currently focused on</span>
            <p class="about-focus-text">量化策略 · 全栈工程</p>
          </div>
        </div>

        <div class="about-experience">
          <div class="timeline">
            <div class="timeline-item">
              <span class="timeline-year">2022 – 2025</span>
              <span class="timeline-logo">TCL</span>
            </div>
            <div class="timeline-item">
              <span class="timeline-year">2025 – 2026</span>
              <span class="timeline-logo">CMB</span>
            </div>
            <div class="timeline-item timeline-item--current">
              <span class="timeline-year">2026 – Now</span>
              <span class="timeline-logo">Manycore Tech</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <h2 class="section-title" id="contact-title">Get In Touch</h2>
        <div class="section-line"></div>
      </div>

      <div class="contact-grid">
        <div class="contact-card contact-card--flower" data-href="mailto:chenrui0411@outlook.com" data-copy="chenrui0411@outlook.com">
          <div class="contact-icon contact-icon--mail" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </div>
          <div>
            <h3>Email</h3>
            <p>chenrui0411@outlook.com</p>
          </div>
          <span class="copy-hint">点击复制</span>
        </div>
        <div class="contact-card contact-card--leaf" data-href="tel:+8619874061160" data-copy="19874061160">
          <div class="contact-icon contact-icon--phone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
          </div>
          <div>
            <h3>WeChat / Phone</h3>
            <p>19874061160</p>
          </div>
          <span class="copy-hint">点击复制</span>
        </div>
        <div class="contact-card contact-card--vine" data-copy="广州">
          <div class="contact-icon contact-icon--pin" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>
          </div>
          <div>
            <h3>Location</h3>
            <p>广州</p>
          </div>
          <span class="copy-hint">点击复制</span>
        </div>
      </div>

      <div class="social-links">
        <a href="https://github.com/RayChan611" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/raychan611" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">LinkedIn ↗</a>
        <a href="https://x.com/raychan22" target="_blank" rel="noopener" class="social-link" aria-label="X">X ↗</a>
        <a href="https://okjk.co/94n6Iu" target="_blank" rel="noopener" class="social-link" aria-label="Jike">Jike ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
