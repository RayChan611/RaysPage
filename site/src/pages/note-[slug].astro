---
import { render } from 'astro:content';
import AmbientBackground from '../components/AmbientBackground.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import ReadingModeToggle from '../components/ReadingModeToggle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedDetailedNotes } from '../lib/content';

// One route generates every detailed note page (note-principles.html, ...).
// Standalone excerpt cards (hasDetail: false) have no detail page, so they
// are filtered out here. Output filename = `note-${slug}.html`.
export async function getStaticPaths() {
  const notes = (await getPublishedDetailedNotes()).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return notes.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: notes[index + 1] || null,
      next: notes[index - 1] || null,
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const { title, description, ogImage, book, author, detailTitle, detailTags, tags } = entry.data;
const pageUrl = `https://www.raychan.top/note-${entry.id}.html`;
const noteTitle = (note: typeof entry) => note.data.detailTitle || note.data.title;
const previousLink = previous ? { href: `note-${previous.id}.html`, title: noteTitle(previous) } : null;
const nextLink = next ? { href: `note-${next.id}.html`, title: noteTitle(next) } : null;
---
<BaseLayout
  title={`${title} | Ray Chan`}
  description={description}
  canonical={pageUrl}
  ogType="article"
  ogImage={ogImage}
  ogUrl={pageUrl}
  twitterImage={ogImage}
  extraCss={["css/essays.css", "css/reading-progress.css"]}
  current="other"
  pageScripts={["js/hero-sparkle.js", "js/reading-mode.js"]}
>
  <AmbientBackground />
  <a href="notes.html" class="note-back-fixed" data-lenis-prevent>&larr; Back</a>
  <main class="note-page">
    <div class="note-title-area">
      <h1 class="note-title">{detailTitle || title}</h1>
      <div class="note-meta-row">
        <span class="note-author">{author || book}</span>
        <span class="note-sep">&middot;</span>
        <span class="note-tag">{(detailTags || tags).join(' · ')}</span>
      </div>
      <div class="article-tools"><ReadingModeToggle /></div>
    </div>
    <article class="note-body"><Content /></article>
    <ArticleNavigation previous={previousLink} next={nextLink} label="Reading Notes 上一篇与下一篇" />
  </main>
</BaseLayout>
