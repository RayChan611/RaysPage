---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// One route generates every detailed note page (note-principles.html, ...).
// Standalone excerpt cards (hasDetail: false) have no detail page, so they
// are filtered out here. Output filename = `note-${slug}.html`.
export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => n.data.hasDetail);
  return notes.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, ogImage } = entry.data;
const pageUrl = `https://www.raychan.top/note-${entry.slug}.html`;
---
<BaseLayout
  title={`${title} | Ray Chan`}
  description={description}
  canonical={pageUrl}
  ogType="article"
  ogImage={ogImage}
  ogUrl={pageUrl}
  twitterImage={ogImage}
  extraCss={["css/essays.css", "css/reading-progress.css"]}
  current="other"
>
  <Content />
</BaseLayout>
<script is:inline defer src="/js/hero-sparkle.js"></script>
<script is:inline defer src="/js/back-lift.js"></script>
