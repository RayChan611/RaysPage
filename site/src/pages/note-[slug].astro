---
import { render } from 'astro:content';
import AmbientBackground from '../components/AmbientBackground.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedDetailedNotes } from '../lib/content';

// One route generates every detailed note page (note-principles.html, ...).
// Standalone excerpt cards (hasDetail: false) have no detail page, so they
// are filtered out here. Output filename = `note-${slug}.html`.
export async function getStaticPaths() {
  const notes = await getPublishedDetailedNotes();
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, ogImage, book, author, detailTitle, detailTags, tags } = entry.data;
const pageUrl = `https://www.raychan.top/note-${entry.id}.html`;
---
<BaseLayout
  title={`${title} | Ray Chan`}
  description={description}
  canonical={pageUrl}
  ogType="article"
  ogImage={ogImage}
  ogUrl={pageUrl}
  twitterImage={ogImage}
  extraCss={["css/essays.css", "css/reading-progress.css"]}
  current="other"
  pageScripts={["js/hero-sparkle.js"]}
>
  <AmbientBackground />
  <a href="notes.html" class="note-back-fixed" data-lenis-prevent>&larr; Back</a>
  <main class="note-page">
    <div class="note-title-area">
      <h1 class="note-title">{detailTitle || title}</h1>
      <div class="note-meta-row">
        <span class="note-author">{author || book}</span>
        <span class="note-sep">&middot;</span>
        <span class="note-tag">{(detailTags || tags).join(' · ')}</span>
      </div>
    </div>
    <article class="note-body"><Content /></article>
  </main>
</BaseLayout>
