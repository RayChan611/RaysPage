---
import BaseLayout from '../layouts/BaseLayout.astro';
const meta = {
  title: "真实的 PDCA | Ray Chan",
  description: "Plan-delay-cancel-apologize。",
  canonical: "https://www.raychan.top/essay-pdca.html",
  ogType: "article",
  ogImage: "https://www.raychan.top/assets/og/essay-pdca.png",
  ogUrl: "https://www.raychan.top/essay-pdca.html",
  twitterImage: "https://www.raychan.top/assets/og/essay-pdca.png",
  extraCss: ["css/essays.css","css/reading-progress.css"],
  current: "other",
  preloadPhoto: false,
  inlineStyles: [".note-back-fixed { position: fixed; bottom: 32px; left: 40px; z-index: 9999; display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.73rem; color: var(--text-muted); text-decoration: none; letter-spacing: 0.06em; padding: 8px 4px; transition: color var(--transition-fast), transform var(--transition-fast); }\n    .note-back-fixed:hover { color: var(--text-primary); transform: translateX(-3px); }\n    @media (max-width: 768px) { .note-back-fixed { bottom: 20px; left: 20px; } }\n\n    .essay-quote-block {\n      margin: 60px 0;\n      padding: 48px 40px;\n      border-left: 1px solid rgba(255,255,255,0.12);\n      background: rgba(255,255,255,0.02);\n    }\n    .essay-quote-text {\n      font-size: clamp(1.3rem, 2.5vw, 1.8rem);\n      line-height: 1.9;\n      color: var(--text-primary);\n      letter-spacing: -0.01em;\n    }\n    .essay-quote-text + .essay-quote-text {\n      margin-top: 20px;\n    }\n    .pdca-line {\n      display: inline-block;\n      font-family: var(--font-mono);\n      font-size: clamp(1rem, 1.5vw, 1.2rem);\n      letter-spacing: 0.02em;\n    }\n    .pdca-ideal {\n      color: var(--text-muted);\n      text-decoration: line-through;\n      opacity: 0.6;\n    }\n    .pdca-real {\n      color: #f5f5f5;\n    }"],
};
const bodyHtml = "<div id=\"global-bg-effect\" class=\"hero-bg-effect\">\n    <div class=\"hero-glow-line hero-glow-line--indigo-blur\"></div>\n    <div class=\"hero-glow-line hero-glow-line--indigo\"></div>\n    <div class=\"hero-glow-line hero-glow-line--sky-blur\"></div>\n    <div class=\"hero-glow-line hero-glow-line--sky\"></div>\n    <canvas id=\"hero-sparkle-canvas\"></canvas>\n  </div>\n  \n  \n\n  \n  <a href=\"essays.html\" class=\"note-back-fixed\" data-lenis-prevent>&larr; Back</a>\n\n  \n  <section class=\"essay-hero\">\n    <div class=\"container\">\n      <h1 class=\"essay-hero-title\">真实的 PDCA</h1>\n      <div class=\"essay-meta\">\n        <span class=\"essay-date\">2026.07.06</span>\n        <span class=\"essay-tag\">Quote</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <article class=\"essay-content section\">\n    <div class=\"container\">\n      <div class=\"essay-body\">\n\n        <div class=\"essay-quote-block\">\n\n          <p class=\"essay-quote-text\">和项目管理的朋友聊天，谈到了 PDCA 循环管理方法。</p>\n\n          <p class=\"essay-quote-text\"><span class=\"pdca-line pdca-ideal\">理想的 PDCA: Plan-do-check-act</span></p>\n\n          <p class=\"essay-quote-text\"><span class=\"pdca-line pdca-real\">真实的 PDCA: Plan-delay-cancel-apologize</span></p>\n\n        </div>\n\n      </div>\n    </div>\n  </article>";
const pageScripts = ["js/card-tilt.js","js/hero-sparkle.js"];
const inlineScripts = ["(function(){var RETRY_MS=300;var btn=document.querySelector('.note-back-fixed');if(!btn)return;var DEFAULT_BOTTOM=32,LIFT_HEIGHT=78,currentBottom=DEFAULT_BOTTOM,targetBottom=DEFAULT_BOTTOM,animId=null;function tick(){var diff=targetBottom-currentBottom;if(Math.abs(diff)<0.3){currentBottom=targetBottom;btn.style.bottom=currentBottom+'px';animId=null;return}currentBottom+=diff*0.055;btn.style.bottom=currentBottom+'px';animId=requestAnimationFrame(tick)}function setupFooterObserver(){var f=document.querySelector('.footer');if(!f){setTimeout(setupFooterObserver,RETRY_MS);return}var io=new IntersectionObserver(function(e){var r=e[0];if(!r)return;var lifted=Math.min(1,r.intersectionRatio*12);targetBottom=DEFAULT_BOTTOM+LIFT_HEIGHT*lifted;if(!animId)animId=requestAnimationFrame(tick)},{threshold:Array.from({length:101},function(_,i){return i/100})});io.observe(f)}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){setTimeout(setupFooterObserver,200)})}else{setTimeout(setupFooterObserver,200)}})();"];
---
<BaseLayout {...meta}>
  <Fragment set:html={bodyHtml} />
  {pageScripts.map((s) => <script is:inline defer src={'/' + s}></script>)}
  {inlineScripts.map((c) => <script is:inline set:html={c}></script>)}
</BaseLayout>
