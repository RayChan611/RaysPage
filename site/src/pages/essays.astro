---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import { formatContentDate, getPublishedEssays } from '../lib/content';

const meta = {
  title: "Soul-Searching | Ray Chan",
  description: "Personal reflections and thoughts by Ray Chan.",
  canonical: "https://www.raychan.top/essays.html",
  ogType: "website",
  ogImage: "https://www.raychan.top/assets/og/default.png",
  ogUrl: "https://www.raychan.top/essays.html",
  twitterImage: "https://www.raychan.top/assets/og/default.png",
  extraCss: ["css/essays.css", "css/reading-progress.css", "css/search.css"],
  current: "essays",
};

// Driven by the `essays` Content Collection — no more hand-maintained cards.
const essays = (await getPublishedEssays()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const pageScripts = ["js/search.js", "js/hero-sparkle.js"];
---
<BaseLayout {...meta} pageScripts={pageScripts}>
  <AmbientBackground />

  <section class="essays-hero">
    <div class="container">
      <h1 class="essays-title">Soul-Searching</h1>
      <p class="essays-subtitle">Thoughts, notes, and scattered ideas.</p>
    </div>
  </section>

  <section class="essays-section section" aria-label="Soul-Searching entries">
    <div class="container">
      <div class="search-container">
        <input type="text" class="search-input" id="searchInput" placeholder="Search Soul-Searching..." aria-label="Search Soul-Searching" />
        <div class="search-no-results" id="searchNoResults" role="status" aria-live="polite" aria-atomic="true">No matching entries found.</div>
      </div>

      <div class="essays-list" id="essaysList">
        {essays.map((e) => (
          <a href={`essay-${e.id}.html`} class="essay-card animate-on-scroll">
            <span class="essay-date">{formatContentDate(e.data.date)}</span>
            <div class="essay-card-body">
              <h2 class="essay-card-title">{e.data.title}</h2>
              <p class="essay-card-excerpt">{e.data.excerpt}</p>
            </div>
            <span class="essay-card-tag">{e.data.tags[0] || 'Essay'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
