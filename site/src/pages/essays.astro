---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import { compareContentNewestFirst, formatContentDate, getPublishedEssays } from '../lib/content';

const meta = {
  title: "Soul-Searching | Ray Chan",
  description: "Personal reflections and thoughts by Ray Chan.",
  canonical: "https://www.raychan.top/essays.html",
  ogType: "website",
  ogImage: "https://www.raychan.top/assets/og/default.png",
  ogUrl: "https://www.raychan.top/essays.html",
  twitterImage: "https://www.raychan.top/assets/og/default.png",
  extraCss: ["css/essays.css", "css/reading-progress.css", "css/search.css"],
  current: "essays",
};

// Driven by the `essays` Content Collection — no more hand-maintained cards.
const essays = (await getPublishedEssays()).sort(compareContentNewestFirst);

const pageScripts = ["js/search.js", "js/hero-sparkle.js"];
---
<BaseLayout {...meta} pageScripts={pageScripts} articleNavigation bodyClass="page-essay-index">
  <AmbientBackground />

  <section class="essays-hero">
    <div class="container">
      <p class="essays-kicker" lang="en">Soul-Searching</p>
      <h1 class="essays-title">随笔</h1>
      <p class="essays-subtitle">一些想法、自省和随手写下的片段。</p>
    </div>
  </section>

  <section class="essays-section section" aria-label="Soul-Searching entries">
    <div class="container">
      <div class="search-container">
        <input type="text" class="search-input" id="searchInput" placeholder="筛选随笔…" aria-label="筛选随笔" />
        <div class="search-no-results" id="searchNoResults" role="status" aria-live="polite" aria-atomic="true" data-no-results="没有找到相符的随笔。"></div>
      </div>

      <div class="essays-list" id="essaysList">
        {essays.map((e) => (
          <a href={`essay-${e.id}.html`} class="essay-card" data-essay-link={e.id} id={`entry-${e.id}`}>
            <span class="essay-date">{formatContentDate(e.data.date)}</span>
            <div class="essay-card-body">
              <h2 class="essay-card-title" style={`view-transition-name: essay-${e.id}`} data-essay-title={e.id}>{e.data.title}</h2>
              <p class="essay-card-excerpt">{e.data.excerpt}</p>
            </div>
            <span class="essay-card-tag">{e.data.tags[0] || 'Essay'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
