---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import { compareContentNewestFirst, getPublishedNotes } from '../lib/content';

const meta = {
  title: "Reading Notes | Ray Chan",
  description: "Reading notes and book excerpts by Ray Chan.",
  canonical: "https://www.raychan.top/notes.html",
  ogType: "website",
  ogImage: "https://www.raychan.top/assets/og/default.png",
  ogUrl: "https://www.raychan.top/notes.html",
  twitterImage: "https://www.raychan.top/assets/og/default.png",
  extraCss: ["css/essays.css", "css/reading-progress.css", "css/search.css"],
  current: "notes",
};

// Driven by the `notes` Content Collection. Standalone excerpt cards
// (hasDetail: false) render as non-linked <article>; detailed notes link out.
const notes = (await getPublishedNotes()).sort(compareContentNewestFirst);

const pageScripts = ["js/search.js", "js/note-cards.js", "js/hero-sparkle.js"];
---
<BaseLayout {...meta} pageScripts={pageScripts}>
  <AmbientBackground />

  <section class="essays-hero">
    <div class="container">
      <h1 class="essays-title">Reading Notes</h1>
      <p class="essays-subtitle">Excerpts from books I've read.</p>
    </div>
  </section>

  <section class="essays-section section" aria-label="Reading notes">
    <div class="container">
      <div class="search-container">
        <input type="text" class="search-input" id="searchInput" placeholder="Search notes..." aria-label="Search notes" />
        <div class="search-no-results" id="searchNoResults" role="status" aria-live="polite" aria-atomic="true">No matching notes found.</div>
      </div>

      <div class="notes-list" id="notesList">
        {notes.map((n) => {
          const excerptHtml = (n.data.excerpt || '').replace(
            /<div[^>]*>\s*READ NOTES\s*&rarr;\s*<\/div>\s*$/i,
            ''
          );
          const inner = (
            <div class="note-card-header">
              <span class="note-book-name">{n.data.book || n.data.title}</span>
              <span class="note-card-tags">
                {!n.data.hasDetail && <span class="note-card-tag note-card-tag--excerpt">摘录</span>}
                <span class="note-card-tag">{n.data.tags[0] || 'Note'}</span>
              </span>
            </div>
            <div
              class="note-excerpt"
              id={`note-summary-${n.id}`}
              set:html={excerptHtml}
            ></div>
          );
          return n.data.hasDetail ? (
            <a id={`note-${n.id}`} href={`note-${n.id}.html`} class="note-card note-card-link animate-on-scroll">
              {inner}
              <span class="note-card-action">Read notes <span aria-hidden="true">&rarr;</span></span>
            </a>
          ) : (
            <article id={`note-${n.id}`} class="note-card note-card-excerpt animate-on-scroll">
              {inner}
              <button
                class="note-expand-button"
                type="button"
                data-note-expand
                aria-expanded="false"
                aria-controls={`note-summary-${n.id}`}
              >
                <span data-note-expand-label>展开全部</span>
                <span aria-hidden="true">&darr;</span>
              </button>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
