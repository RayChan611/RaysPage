---
import BaseLayout from '../layouts/BaseLayout.astro';
const meta = {
  title: "不是做错什么，而是没做对什么 | Ray Chan",
  description: "有时候不是你做错什么，而是你没做对什么。",
  canonical: "https://www.raychan.top/essay-right.html",
  ogType: "article",
  ogImage: "https://www.raychan.top/assets/og/essay-right.png",
  ogUrl: "https://www.raychan.top/essay-right.html",
  twitterImage: "https://www.raychan.top/assets/og/essay-right.png",
  extraCss: ["css/essays.css","css/reading-progress.css"],
  current: "other",
  preloadPhoto: false,
  inlineStyles: [".note-back-fixed { position: fixed; bottom: 32px; left: 40px; z-index: 9999; display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.73rem; color: var(--text-muted); text-decoration: none; letter-spacing: 0.06em; padding: 8px 4px; transition: color var(--transition-fast), transform var(--transition-fast); }\n    .note-back-fixed:hover { color: var(--text-primary); transform: translateX(-3px); }\n    @media (max-width: 768px) { .note-back-fixed { bottom: 20px; left: 20px; } }\n\n    .essay-quote-block {\n      margin: 60px 0;\n      padding: 48px 40px;\n      border-left: 1px solid rgba(255,255,255,0.12);\n      background: rgba(255,255,255,0.02);\n    }\n    .essay-quote-text {\n      font-size: clamp(1.15rem, 2vw, 1.5rem);\n      line-height: 1.9;\n      color: var(--text-primary);\n      letter-spacing: -0.01em;\n    }\n    .essay-quote-text + .essay-quote-text {\n      margin-top: 24px;\n    }\n    .essay-conclusion {\n      margin-top: 40px;\n      padding-top: 28px;\n      border-top: 1px solid rgba(255,255,255,0.08);\n      font-size: clamp(1.25rem, 2.5vw, 1.7rem);\n      line-height: 1.8;\n      color: #f5f5f5;\n      letter-spacing: -0.01em;\n      text-align: center;\n    }"],
};
const bodyHtml = "<div id=\"global-bg-effect\" class=\"hero-bg-effect\">\n    <div class=\"hero-glow-line hero-glow-line--indigo-blur\"></div>\n    <div class=\"hero-glow-line hero-glow-line--indigo\"></div>\n    <div class=\"hero-glow-line hero-glow-line--sky-blur\"></div>\n    <div class=\"hero-glow-line hero-glow-line--sky\"></div>\n    <canvas id=\"hero-sparkle-canvas\"></canvas>\n  </div>\n  \n  \n\n  \n  <a href=\"essays.html\" class=\"note-back-fixed\" data-lenis-prevent>&larr; Back</a>\n\n  \n  <section class=\"essay-hero\">\n    <div class=\"container\">\n      <h1 class=\"essay-hero-title\">不是做错什么，<br>而是没做对什么</h1>\n      <div class=\"essay-meta\">\n        <span class=\"essay-date\">2026.07.06</span>\n        <span class=\"essay-tag\">Business</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <article class=\"essay-content section\">\n    <div class=\"container\">\n      <div class=\"essay-body\">\n\n        <div class=\"essay-quote-block\">\n\n          <p class=\"essay-quote-text\">今天刷到一个非常感慨的事情，健身服务 Keep 因递交招股书 6 个月内未通过聆讯，IPO 申请状态已转为「失败」，这大概率意味着本次冲刺 IPO 失败了。</p>\n\n          <p class=\"essay-quote-text\">9 轮融资了超过 8 亿美金、估值 130 亿如今沦为「卖货」平台，2021 年前三个季度，Keep 亏损更是达到 24.58 亿元。在 Web2.0 的世界里，资本退出最大的路径就是上市，但大环境直接扼杀了这条路径。</p>\n\n          <p class=\"essay-quote-text\">对比下类似的 Web3 应用 Stepn，同样赛道、相似的用户群、百分之一的用户数，上线不到一年估值就超过了 10 亿美金，更关键的是，项目方赚钱啊，实实在在的真金白银，Stepn 月收入超 7 亿元，每日交易费用净利润达 3342 万元，而 Stepn 用户仅仅有 300 万不到，Keep 用户超过 3 亿。</p>\n\n        </div>\n\n        <p class=\"essay-conclusion\">有时候不是你做错什么，而是你没做对什么。</p>\n\n      </div>\n    </div>\n  </article>";
const pageScripts = ["js/card-tilt.js","js/hero-sparkle.js"];
const inlineScripts = ["(function(){var RETRY_MS=300;var btn=document.querySelector('.note-back-fixed');if(!btn)return;var DEFAULT_BOTTOM=32,LIFT_HEIGHT=78,currentBottom=DEFAULT_BOTTOM,targetBottom=DEFAULT_BOTTOM,animId=null;function tick(){var diff=targetBottom-currentBottom;if(Math.abs(diff)<0.3){currentBottom=targetBottom;btn.style.bottom=currentBottom+'px';animId=null;return}currentBottom+=diff*0.055;btn.style.bottom=currentBottom+'px';animId=requestAnimationFrame(tick)}function setupFooterObserver(){var f=document.querySelector('.footer');if(!f){setTimeout(setupFooterObserver,RETRY_MS);return}var io=new IntersectionObserver(function(e){var r=e[0];if(!r)return;var lifted=Math.min(1,r.intersectionRatio*12);targetBottom=DEFAULT_BOTTOM+LIFT_HEIGHT*lifted;if(!animId)animId=requestAnimationFrame(tick)},{threshold:Array.from({length:101},function(_,i){return i/100})});io.observe(f)}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){setTimeout(setupFooterObserver,200)})}else{setTimeout(setupFooterObserver,200)}})();"];
---
<BaseLayout {...meta}>
  <Fragment set:html={bodyHtml} />
  {pageScripts.map((s) => <script is:inline defer src={'/' + s}></script>)}
  {inlineScripts.map((c) => <script is:inline set:html={c}></script>)}
</BaseLayout>
