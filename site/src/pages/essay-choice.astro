---
import BaseLayout from '../layouts/BaseLayout.astro';
const meta = {
  title: "选择的代价 | Ray Chan",
  description: "关于选择与代价的思考：每个选择都有价格，只是高低不同。",
  canonical: "https://www.raychan.top/essay-choice.html",
  ogType: "article",
  ogImage: "https://www.raychan.top/assets/og/essay-choice.png",
  ogUrl: "https://www.raychan.top/essay-choice.html",
  twitterImage: "https://www.raychan.top/assets/og/essay-choice.png",
  extraCss: ["css/essays.css","css/reading-progress.css"],
  current: "other",
  preloadPhoto: false,
  inlineStyles: [".note-back-fixed { position: fixed; bottom: 32px; left: 40px; z-index: 9999; display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.73rem; color: var(--text-muted); text-decoration: none; letter-spacing: 0.06em; padding: 8px 4px; transition: color var(--transition-fast), transform var(--transition-fast); }\n    .note-back-fixed:hover { color: var(--text-primary); transform: translateX(-3px); }\n    @media (max-width: 768px) { .note-back-fixed { bottom: 20px; left: 20px; } }"],
};
const bodyHtml = "<div id=\"global-bg-effect\" class=\"hero-bg-effect\">\n    <div class=\"hero-glow-line hero-glow-line--indigo-blur\"></div>\n    <div class=\"hero-glow-line hero-glow-line--indigo\"></div>\n    <div class=\"hero-glow-line hero-glow-line--sky-blur\"></div>\n    <div class=\"hero-glow-line hero-glow-line--sky\"></div>\n    <canvas id=\"hero-sparkle-canvas\"></canvas>\n  </div>\n  \n  \n\n  \n  <a href=\"javascript:history.back()\" class=\"note-back-fixed\" data-lenis-prevent>&larr; Back</a>\n\n  \n  <section class=\"essay-hero\">\n    <div class=\"container\">\n      <h1 class=\"essay-hero-title\">选择的代价</h1>\n      <div class=\"essay-meta\">\n        <span class=\"essay-date\">2026.07.01</span>\n        <span class=\"essay-tag\">Choice</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <article class=\"essay-content section\">\n    <div class=\"container\">\n      <div class=\"essay-body\">\n\n        <h2>每个选择都有价格</h2>\n        <p>选择从来不是孤立的，它依赖于当时能看到的条件。人能做出的选择，永远被当时能接触到的条件所框定。不是不想跳，是脚下没有可以落脚的石头。</p>\n        <p>每一个选择都有价格。不是说有的选择没代价，只是看你愿不愿意正视它。<strong>没有\"免费的选择\"，只有隐藏的账单。</strong></p>\n\n        <h2>价格是相对的</h2>\n        <p>同样一件事，对不同的人价格不一样。价格不是客观的，是相对于你的处境、阶段、资源结构而言的。所以不要用你的选择去判断别人——你不知道他看到的价格是多少。</p>\n\n        <h2>不选也是选</h2>\n        <p>人性就是会为看不到代价的选择，付出更高的代价。我们以为不选就不用付，其实不选本身就是一个选择——代价是别人在替你选、时代在替你选、惰性在替你选。</p>\n        <p>真正的成熟，不是看穿所有代价，而是知道：<strong>每个选择都有价，差别只在于那个价，你愿不愿意付。</strong></p>\n\n        <h2>知道自己的价位</h2>\n        <p>成熟的决策者，不是不计代价，而是提前知道自己的价位：能承受多少、不能承受什么、愿意为哪些东西放弃哪些东西。有了价位，决策就成了主动的筛选——你不是在选\"最对的\"，而是在选\"我愿意为之付的\"。</p>\n\n        <h2>相变的潜热</h2>\n        <p>万物运行的逻辑都差不多。分裂、聚变是怎么来的？都是粒子在\"选择\"——在外力作用下，跨过一个能垒，落到能量更低的态。人也是如此：<strong>每一个选择都是一次相变，跨过临界点，世界就不一样了。</strong>价格不是代价，价格是相变的潜热。你付了，才能变。</p>\n\n      </div>\n    </div>\n  </article>";
const pageScripts = ["js/card-tilt.js","js/hero-sparkle.js"];
const inlineScripts = ["(function(){var RETRY_MS=300;var btn=document.querySelector('.note-back-fixed');if(!btn)return;var DEFAULT_BOTTOM=32,LIFT_HEIGHT=78,currentBottom=DEFAULT_BOTTOM,targetBottom=DEFAULT_BOTTOM,animId=null;function tick(){var diff=targetBottom-currentBottom;if(Math.abs(diff)<0.3){currentBottom=targetBottom;btn.style.bottom=currentBottom+'px';animId=null;return}currentBottom+=diff*0.055;btn.style.bottom=currentBottom+'px';animId=requestAnimationFrame(tick)}function setupFooterObserver(){var f=document.querySelector('.footer');if(!f){setTimeout(setupFooterObserver,RETRY_MS);return}var io=new IntersectionObserver(function(e){var r=e[0];if(!r)return;var lifted=Math.min(1,r.intersectionRatio*12);targetBottom=DEFAULT_BOTTOM+LIFT_HEIGHT*lifted;if(!animId)animId=requestAnimationFrame(tick)},{threshold:Array.from({length:101},function(_,i){return i/100})});io.observe(f)}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){setTimeout(setupFooterObserver,200)})}else{setTimeout(setupFooterObserver,200)}})();"];
---
<BaseLayout {...meta}>
  <Fragment set:html={bodyHtml} />
  {pageScripts.map((s) => <script is:inline defer src={'/' + s}></script>)}
  {inlineScripts.map((c) => <script is:inline set:html={c}></script>)}
</BaseLayout>
