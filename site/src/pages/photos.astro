---
import AmbientBackground from '../components/AmbientBackground.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photoSeries } from '../data/photos';

const meta = {
  title: 'Photography | Ray Chan',
  description: 'Photography by Ray Chan — moments captured in monochrome, grouped by series.',
  canonical: 'https://www.raychan.top/photos.html',
  ogType: 'website',
  ogImage: 'https://www.raychan.top/assets/og/default.png',
  ogUrl: 'https://www.raychan.top/photos.html',
  twitterImage: 'https://www.raychan.top/assets/og/default.png',
  extraCss: ['css/photos.css'],
  current: 'photos',
  preloadPhoto: false,
};

const pageScripts = ['js/hero-sparkle.js', 'js/photos.js'];
---
<BaseLayout {...meta} pageScripts={pageScripts}>
  <AmbientBackground />

  <section class="photos-hero">
    <div class="container">
      <h1 class="photos-title">Photography</h1>
      <p class="photos-subtitle">Moments captured in monochrome, grouped by series.</p>
    </div>
  </section>

  <nav class="series-nav" id="seriesNav" aria-label="Photo series">
    <div class="container">
      {photoSeries.map((item, index) => (
        <>
          {index > 0 && <span class="series-nav-divider" aria-hidden="true">/</span>}
          <a
            href={`#series-${item.id}`}
            class:list={['series-nav-link', { active: index === 0 }]}
            data-target={`series-${item.id}`}
          >
            {item.nav}
          </a>
        </>
      ))}
    </div>
  </nav>

  {photoSeries.map((item) => (
    <section class="series-section" id={`series-${item.id}`} aria-labelledby={`${item.id}-title`}>
      <div class="container">
        <div class="series-header animate-on-scroll">
          <div class="series-header-left">
            <div class="series-title-block">
              <h2 class="series-name" id={`${item.id}-title`}>{item.name}</h2>
              <span class="series-meta">{item.nameEn} · {item.photos.length} photos</span>
            </div>
          </div>
          <p class="series-desc">{item.description}</p>
        </div>
        <div class="gallery-grid" id={`gallery-${item.id}`}>
          {item.photos.map((photo) => {
            const wide = photo.layout.includes('wide') || photo.layout === 'feature';
            const sizes = wide ? '(max-width: 768px) 100vw, 55vw' : '(max-width: 768px) 50vw, 25vw';
            const srcset = photo.width > photo.thumbWidth
              ? `${photo.thumb} ${photo.thumbWidth}w, ${photo.src} ${photo.width}w`
              : undefined;
            return (
              <div
                class={`gallery-item gallery-item--${photo.layout} animate-on-scroll`}
                data-layout={photo.layout}
                data-title={photo.title}
                data-series={item.name}
                data-full={photo.src}
                role="button"
                tabindex="0"
                aria-haspopup="dialog"
                aria-label={`${photo.title} - 点击查看大图`}
              >
                <img
                  src={photo.thumb}
                  srcset={srcset}
                  sizes={sizes}
                  width={photo.thumbWidth}
                  height={photo.thumbHeight}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                />
                <div class="gallery-overlay">
                  <span class="gallery-number">{String(photo.index + 1).padStart(2, '0')}</span>
                  <h3>{photo.title}</h3>
                  <p>{photo.description}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <div
    class="lightbox"
    id="lightbox"
    slot="overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
    aria-hidden="true"
    data-lenis-prevent
    hidden
    inert
  >
    <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
    <button class="lightbox-prev" type="button" aria-label="Previous image">&#8249;</button>
    <button class="lightbox-next" type="button" aria-label="Next image">&#8250;</button>
    <div class="lightbox-content">
      <img alt="" id="lightboxImg" />
    </div>
    <div class="lightbox-info">
      <span class="lightbox-title" id="lightboxTitle"></span>
      <span class="lightbox-counter" id="lightboxCounter"></span>
    </div>
  </div>
</BaseLayout>
