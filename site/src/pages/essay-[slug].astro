---
import { render } from 'astro:content';
import AmbientBackground from '../components/AmbientBackground.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatContentDate, getPublishedEssays } from '../lib/content';

// One route generates every essay detail page (essay-choice.html, ...).
// `build.format: 'file'` keeps the output filename = `essay-${slug}.html`,
// so existing links / SEO are preserved.
export async function getStaticPaths() {
  const essays = await getPublishedEssays();
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, ogImage, date, tags } = entry.data;
const pageUrl = `https://www.raychan.top/essay-${entry.id}.html`;
---
<BaseLayout
  title={`${title} | Ray Chan`}
  description={description}
  canonical={pageUrl}
  ogType="article"
  ogImage={ogImage}
  ogUrl={pageUrl}
  twitterImage={ogImage}
  extraCss={["css/essays.css", "css/reading-progress.css"]}
  current="other"
  pageScripts={["js/hero-sparkle.js"]}
>
  <AmbientBackground />
  <a href="essays.html" class="note-back-fixed" data-lenis-prevent>&larr; Back</a>
  <section class="essay-hero">
    <div class="container">
      <h1 class="essay-hero-title">{title}</h1>
      <div class="essay-meta">
        <span class="essay-date">{formatContentDate(date)}</span>
        {tags.map((tag) => <span class="essay-tag">{tag}</span>)}
      </div>
    </div>
  </section>
  <article class="essay-content section">
    <div class="container">
      <div class="essay-body"><Content /></div>
    </div>
  </article>
</BaseLayout>
