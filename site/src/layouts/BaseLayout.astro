---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  ogUrl?: string;
  twitterImage?: string;
  extraCss?: string[];
  current?: string;
  preloadPhoto?: boolean;
  inlineStyles?: string[];
  pageScripts?: string[];
}
const {
  title = 'Ray Chan',
  description = 'Ray Chan - Ground-up rebuild, quant strategies, full-stack engineering, personal reconstruction.',
  canonical = 'https://www.raychan.top/',
  ogType = 'website',
  ogImage = 'https://www.raychan.top/assets/og/default.png',
  // Use the real file path (index.html) as og:url instead of "/" so social
  // platforms (Feishu/WeChat) that dedupe link-preview cards by og:url don't
  // serve a stale cached card for the root URL. Home/About/Contact all resolve
  // to index.html, so this stays correct. canonical stays "/" for SEO.
  ogUrl = 'https://www.raychan.top/index.html',
  twitterImage = ogImage,
  extraCss = [],
  current = 'home',
  preloadPhoto = false,
  inlineStyles = [],
  pageScripts = [],
} = Astro.props;

const NAV_ITEMS = [
  { href: 'index.html#about', label: 'About', key: 'about' },
  { href: 'index.html#contact', label: 'Contact', key: 'contact' },
  { href: 'photos.html', label: 'Photos', key: 'photos' },
  { href: 'notes.html', label: 'Notes', key: 'notes' },
  { href: 'essays.html', label: 'Soul-Searching', key: 'essays' },
];
const onIndex = current === 'home' || current === 'about' || current === 'contact';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="baidu-site-verification" content="codeva-FkS9J5NQKE" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Ray Chan" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ray Chan" />
  <meta property="og:site_name" content="Ray Chan" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:type" content={ogType} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={twitterImage} />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="alternate" type="application/rss+xml" title="Ray Chan" href="/rss.xml" />
  <style>
    html, body { background: #0a0a0a; margin: 0; }
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 20px 40px; }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;500;600;700&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/quick-search.css" />
  {extraCss.map((href) => <link rel="stylesheet" href={'/' + href} />)}
  {inlineStyles.map((css) => <style is:inline set:html={css}></style>)}
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="05a8cc57-1dd2-4a0e-bc35-ff78348b4982"></script>
  {preloadPhoto && <link rel="preload" as="image" href="/assets/ray-photo.webp" fetchpriority="high" />}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- Hidden by default so content remains usable without JavaScript. The
       temporary class supplies a CSS-only failsafe if site.js cannot boot. -->
  <div class="page-transition-overlay" id="pageTransitionOverlay" aria-hidden="true"></div>
  <script is:inline>
    document.getElementById('pageTransitionOverlay')?.classList.add('page-transition-overlay--entering');
  </script>

  <!-- RayRAF + page behaviours. Loaded synchronously before page scripts so
       window.RayRAF exists when their animation loops register. -->
  <script is:inline src="/js/site.js"></script>

  <!-- Reading progress bar (was injected by the old components.js; now static). -->
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <nav class="nav scrolled" id="nav" aria-label="Main navigation">
    <div class="nav-inner">
      <a href="index.html" class="nav-logo" aria-label="Ray Chan - Home"><span class="nav-logo-c">R</span><span class="nav-logo-expand">ay&nbsp;</span><span class="nav-logo-r">C</span><span class="nav-logo-expand2">han</span></a>
      <div class="nav-right">
        <div class="nav-links" id="navLinks">
          {NAV_ITEMS.map((item) => {
            if (onIndex && (item.key === 'about' || item.key === 'contact')) {
              const isActive = item.key === current;
              return <a class={isActive ? 'nav-link nav-link-active' : 'nav-link'} href={'#' + item.key} aria-current={isActive ? 'page' : undefined}>{item.label}</a>;
            }
            const isActive = item.key === current;
            const cls = isActive ? 'nav-link nav-link-active' : 'nav-link';
            return isActive
              ? <span class={cls} aria-current="page">{item.label}</span>
              : <a class={cls} href={item.href}>{item.label}</a>;
          })}
        </div>
        <button
          class="quick-search-trigger"
          id="quickSearchTrigger"
          type="button"
          aria-label="打开全站搜索"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="quickSearch"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.8-3.8"></path>
          </svg>
          <span class="quick-search-key" data-search-shortcut>&#8984;K</span>
        </button>
        <button class="nav-mobile-btn" id="navMobileBtn" aria-label="Menu" aria-expanded="false" aria-controls="navLinks"><span></span><span></span></button>
      </div>
    </div>
  </nav>

  <div class="quick-search" id="quickSearch" hidden aria-hidden="true" data-lenis-prevent>
    <div class="quick-search-backdrop" data-search-close aria-hidden="true"></div>
    <section class="quick-search-panel" role="dialog" aria-modal="true" aria-labelledby="quickSearchTitle">
      <header class="quick-search-header">
        <div class="quick-search-heading">
          <span class="quick-search-eyebrow">Search the archive</span>
          <h2 id="quickSearchTitle">Find a signal.</h2>
        </div>
        <button class="quick-search-close" type="button" data-search-close aria-label="关闭搜索">Esc</button>
      </header>
      <div class="quick-search-field">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.8-3.8"></path>
        </svg>
        <input
          id="quickSearchInput"
          type="search"
          placeholder="搜索文章、笔记、照片与页面…"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="quickSearchResults"
          aria-expanded="false"
        />
      </div>
      <p class="quick-search-status" id="quickSearchStatus" role="status" aria-live="polite"></p>
      <div class="quick-search-results" id="quickSearchResults" role="listbox" aria-label="搜索结果"></div>
      <footer class="quick-search-footer">
        <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> Navigate</span>
        <span><kbd>&crarr;</kbd> Open</span>
        <span><kbd>Esc</kbd> Close</span>
      </footer>
    </section>
  </div>

  <main class="site-main" id="main-content" tabindex="-1">
    <slot />
  </main>
  <slot name="overlay" />

  <footer class="footer">
    <div class="container">
      <p class="footer-sign">&mdash; Ray Chan</p>
      <p class="footer-sign-sub">Between the written and the unspoken &middot; <a class="footer-link" href="/rss.xml" aria-label="RSS 订阅">RSS</a></p>
    </div>
  </footer>
  <button class="back-to-top" id="backToTop" aria-label="Back to top" title="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5"/>
      <path d="M5 12l7-7 7 7"/>
    </svg>
  </button>

  <!-- Global client scripts (load order matters: lenis before smooth-scroll). -->
  <script is:inline src="/js/vendor/lenis.min.js"></script>
  <script is:inline src="/js/smooth-scroll.js"></script>
  <script is:inline src="/js/nav.js"></script>
  <script is:inline defer src="/js/quick-search.js"></script>
  <!-- back-lift is global: #backToTop exists on every page and must clear the
       footer divider everywhere, not just on essay/note detail pages. -->
  <script is:inline defer src="/js/back-lift.js"></script>
  {pageScripts.map((src) => <script is:inline defer src={'/' + src}></script>)}
</body>
</html>
