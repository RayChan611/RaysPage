{
  "name": "rayspage-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "photos:optimize": "node --experimental-strip-types scripts/generate-photo-variants.mjs",
    "validate": "node scripts/validate-dist.mjs",
